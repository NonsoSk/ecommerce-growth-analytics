htmlcov/

# Data is private by default; sample data requires manual review
/data/generated/
/data/*
!/data/README.md
!/data/sample/
*.parquet
*.sqlite*
*.db
*.csv
*.tsv
*.xlsx
*.xls
*.jsonl
*.ndjson
*.zip
