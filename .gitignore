*service*account*.json
*.pem
*.key
*.p12
*.pfx

# Environments and Python outputs
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
