!/data/sample/*.json

# Generated artifacts may contain customer information
/reports/*
!/reports/README.md
!/reports/MILESTONE_2_ANALYSIS.md
/notebooks/.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.log
*.tmp
*.temp
*.bak
*~
.DS_Store
.idea/
.vscode/

# Reviewed baseline-only dashboard aggregates; never include quality fixtures here
!/dashboard/data/overview.csv
!/dashboard/data/funnel.csv
!/dashboard/data/acquisition.csv
/dashboard/data/preview_data.js
/dashboard/workbooks/
