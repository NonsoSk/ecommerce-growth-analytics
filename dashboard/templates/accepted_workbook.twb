      </column>
      <column caption="Advertising spend USD" datatype="real" default-format="c&quot;$&quot;#,##0.00" name="[Metric_7]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([missing_spend_days])=0 THEN SUM([spend_cents])/100.0 END" />
