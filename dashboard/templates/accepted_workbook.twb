      <column caption="Eligible reporting rows" datatype="boolean" name="[Eligible]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[day] &gt;= [Parameters].[Start] AND [day] &lt;= [Parameters].[End]" />
      </column>
      <column caption="Sessions" datatype="integer" name="[Metric_1]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([sessions])" />
      </column>
      <column caption="Converting sessions" datatype="integer" name="[Metric_2]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([converting_sessions])" />
      </column>
      <column caption="Purchase conversion" datatype="real" default-format="p0.00%" name="[Metric_3]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF SUM([sessions]) &gt; 0 THEN SUM([converting_sessions])/SUM([sessions]) END" />
      </column>
      <column caption="Orders" datatype="integer" name="[Metric_4]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([orders])" />
      </column>
      <column caption="Net merchandise revenue USD" datatype="real" default-format="c&quot;$&quot;#,##0.00" name="[Metric_5]" role="measure" type="quantitative">
